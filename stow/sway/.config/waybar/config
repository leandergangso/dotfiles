{
    "layer": "top",
    "position": "top",
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "sway/language"
    ],

    "sway/workspaces": {
        "disable-scroll-wraparound": true,
        "enable-bar-scroll": true,
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "{}"
    },
    "clock": {
        "format": "{:%A %H:%M}",
        "tooltip-format": "{:%d-%m-%Y}"
    },
    "cpu": {
        "format": "  {usage}%",
        "interval": 5
    },
    "memory": {
        "format": "  {}%",
        "interval": 5
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": " Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  Connected",
        "format-disconnected": "󰤮  Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}"
    },
    "sway/language": {
        "format": "  {}",
    }
}
